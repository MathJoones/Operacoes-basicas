programa {
  funcao inicio() {

    inteiro x, y
    inteiro resultado, resultado1
    
    escreva("Defina um valor para A: ")
    leia(x)

    escreva("\n**\nDefina um valor para B: ")
    leia(y)

    resultado = x + y
    escreva("\n**\nA soma dos valores A e B é: ", resultado)
    
    resultado1 = x - y
    escreva("\n**\nA subtracao dos valores A e B é: ", resultado1)



  }
}
